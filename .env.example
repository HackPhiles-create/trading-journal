# Local development
DATABASE_URL="file:./prisma/dev.db"

# Required everywhere — signs login session cookies. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session (forces re-login).
SESSION_SECRET=""

# Production only (e.g. Railway): point these at a path inside a mounted
# persistent volume, or the database and uploaded screenshots are wiped on
# every redeploy.
# DATABASE_URL="file:/data/prod.db"
# UPLOADS_DIR="/data/uploads"
